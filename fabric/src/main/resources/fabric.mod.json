{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${mod_version}",
    "name": "${mod_name}",
    "description": "${mod_description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "sources": "https://github.com/palmmc/Wayfarer"
    },
    "license": "${license}",
    "icon": "${mod_id}.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.wayfarer.WayfarerFabric"
        ],
        "client": [
            "com.wayfarer.WayfarerFabricClient"
        ],
        "modmenu": [
            "com.wayfarer.client.WayfarerModMenu"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "fabric-key-mapping-api-v1": "*",
        "minecraft": "~${minecraft_version}",
        "java": ">=${java_version}"
    }
}